# ---------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# ---------------------------------------------------------------------------

# --- Database (Supabase -> Project Settings -> Database -> Connection string)
# Use the "Session pooler" URI and swap the scheme to postgresql+asyncpg://
DATABASE_URL=postgresql+asyncpg://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# --- OpenAI (the only model vendor; one key for chat + embeddings)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_CLASSIFIER_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=1536

# --- Supabase Auth (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_JWT_SECRET=
# No service-role key is needed. Nothing in this app calls the Supabase
# API, and that key bypasses Row Level Security.

# --- App
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=20

# --- Retrieval tuning
RETRIEVAL_CANDIDATES=50
RETRIEVAL_TOP_K=12
RRF_K=60
